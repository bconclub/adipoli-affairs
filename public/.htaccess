# Enable Rewrite Engine
RewriteEngine On

# Allow access to all files and directories (prevent 403 errors)
Options -Indexes +FollowSymLinks +ExecCGI

# Allow all file types to be accessed
<FilesMatch "\.(html|htm|js|css|png|jpg|jpeg|gif|svg|ico|json|woff|woff2|ttf|eot)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Set default index file
DirectoryIndex index.html

# Next.js also makes a folder per page (e.g. /about/), so stop Apache redirecting
# /about to the folder, which is blocked and showed the home page instead
DirectorySlash Off

# Serve a smaller WebP copy of a photo when the browser supports it and one exists
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{REQUEST_FILENAME} ^(.+)\.(png|jpe?g)$
RewriteCond %1.webp -f
RewriteRule ^(images/.+)\.(png|jpe?g)$ /$1.webp [T=image/webp,L]

# Serve each page's .html file, e.g. /about or /about/ -> about.html
RewriteCond %{REQUEST_URI} ^/([^/.]+)/?$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^([^/.]+)/?$ /$1.html [L]

# Handle subdirectories - serve index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# Fallback: For any other route, serve index.html (client-side routing)
# This handles missing files gracefully
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/index.html$
RewriteCond %{REQUEST_URI} !\.(png|jpg|jpeg|gif|svg|ico|css|js|woff|woff2|ttf|eot|json)$
RewriteRule ^(.*)$ /index.html [L]

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Set proper MIME types
<IfModule mod_mime.c>
    AddType application/javascript js
    AddType text/css css
    AddType image/svg+xml svg
    AddType application/json json
    AddType image/png png
    AddType image/jpeg jpg jpeg
    AddType image/gif gif
    AddType image/webp webp
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    # Photos differ by browser once WebP copies are served
    <FilesMatch "\.(png|jpe?g|webp)$">
        Header append Vary Accept
    </FilesMatch>
</IfModule>

# Custom error pages (optional - helps with debugging)
ErrorDocument 404 /index.html
ErrorDocument 403 /index.html
